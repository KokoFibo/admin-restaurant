# ===== Publik (dibaca browser lewat build; wajib berawalan PUBLIC_) =====
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...           # anon/publishable key, BUKAN service_role
PUBLIC_MEDIA_URL=https://images.kokofibo.com   # alamat publik bucket Cloudflare R2
# Domain dasar website restoran tanpa domain sendiri: https://<slug>.<PUBLIC_BASE_DOMAIN> (nanti ganti ke dapora.com)
PUBLIC_BASE_DOMAIN=kokofibo.com

# ===== Rahasia (hanya Functions; di Cloudflare simpan sebagai Secret, jangan diberi awalan PUBLIC_) =====
GEMINI_API_KEY=AIza...
# AI_MODEL=                               # opsional: paksa satu model
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=nama-bucket-r2-kamu
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...             # membuat/mengelola akun, lupa kata sandi
# Functions membaca PUBLIC_SUPABASE_URL dan PUBLIC_SUPABASE_ANON_KEY dari variabel yang sama.
