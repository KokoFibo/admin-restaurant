# ===== Publik (dibaca browser lewat build; wajib berawalan PUBLIC_) =====
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...           # anon/publishable key, BUKAN service_role
PUBLIC_MEDIA_URL=https://images.kokofibo.com   # alamat publik bucket Cloudflare R2
# Domain dasar website restoran tanpa domain sendiri: https://<slug>.<PUBLIC_BASE_DOMAIN>
PUBLIC_BASE_DOMAIN=dapora.id

# ===== Rahasia (hanya Functions; di Cloudflare simpan sebagai Secret, jangan diberi awalan PUBLIC_) =====
GEMINI_API_KEY=AIza...
# AI_MODEL=                               # opsional: paksa satu model
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=nama-bucket-r2-kamu
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...             # membuat/mengelola akun, lupa kata sandi
# Functions membaca PUBLIC_SUPABASE_URL dan PUBLIC_SUPABASE_ANON_KEY dari variabel yang sama.

# ===== Dapora: pendaftaran mandiri (Functions) =====
# Isi NILAI ASLI hanya di Cloudflare Pages (Secret) atau .dev.vars lokal (sudah di-gitignore). File ini hanya contoh dan ikut ter-commit.
SIGNUP_ENABLED=true                       # wajib agar /api/signup aktif; bawaan mati
SIGNUP_ALLOWED_ORIGINS=https://dapora.id   # origin website pemasaran yang boleh memanggil /api/signup (CORS); koma untuk beberapa
SIGNUP_AUTO_CONFIRM=false                 # false = kirim email konfirmasi (butuh SMTP kustom di Supabase); true = langsung aktif (hanya uji)
# SIGNUP_PLAN=basic
# TURNSTILE_SECRET=...                    # Secret; sangat disarankan di produksi (pasangannya VITE_TURNSTILE_SITEKEY di website)
# ALLOW_SLUG_FALLBACK=false               # pratinjau saja; JANGAN true di produksi

# ===== Dapora: domain kustom (OPSIONAL; Cloudflare for SaaS, custom hostname persis) =====
# CF_SAAS_ENABLED=true
# CF_ZONE_ID=...                          # zona domain dasar
# CF_CNAME_TARGET=cname.dapora.id
# CF_MAX_CUSTOM_DOMAINS=1
# CF_API_TOKEN=...                        # Secret. Izin minimal: SSL and Certificates: Edit (zona domain dasar)
