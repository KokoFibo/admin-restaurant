# ---- Tambahan Dapora (admin/backend; Cloudflare Pages → Settings → Variables and Secrets) ----
PUBLIC_BASE_DOMAIN=dapora.id        # variabel BUILD (berawalan PUBLIC_)
# ALLOW_SLUG_FALLBACK=false               # pratinjau saja; JANGAN true di produksi

# ---- Pendaftaran mandiri ----
SIGNUP_ENABLED=true                       # wajib; bawaan mati
SIGNUP_ALLOWED_ORIGINS=https://dapora.id   # origin website pemasaran yang boleh memanggil /api/signup (CORS); koma untuk beberapa
SIGNUP_AUTO_CONFIRM=false                 # false = kirim email konfirmasi (butuh SMTP kustom di Supabase); true = langsung aktif (hanya uji)
# SIGNUP_PLAN=basic
TURNSTILE_SECRET=0x4AAAAAAFxZnRvv9UJAJJ7KwvjpfVMTeJM                   # Secret; sangat disarankan di produksi
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFxZndumSrhI9WIw           # variabel BUILD, dipakai form daftar

# ---- Domain kustom (OPSIONAL; Cloudflare for SaaS, custom hostname persis) ----
CF_SAAS_ENABLED=true
# CF_ZONE_ID=...                          # zona dapora.id
# CF_CNAME_TARGET=cname.dapora.id
# CF_MAX_CUSTOM_DOMAINS=1
# CF_API_TOKEN=...                        # Secret. Izin minimal: SSL and Certificates: Edit (zona domain dasar)
# ok